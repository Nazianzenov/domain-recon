{
  "name": "domain-recon",
  "description": "Investigate a single domain from the Firefox sidebar: DNS, RDAP, passive DNS, M365 tenant, email providers, favicon hashes, threat intel and AI brand checks.",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "build": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "web-ext lint --source-dir .output/firefox-mv3",
    "check": "npm run typecheck && npm run test && npm run build && npm run lint",
    "postinstall": "wxt prepare",
    "build-for-amo": "wxt build -b firefox --mv3"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "preact": "^11.2.0",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=24"
  }
}
